# Weather is provided by Open-Meteo without an API key (forecast model output,
# not a local weather station observation).
OPENWEATHER_API_KEY=

# Optional IMD API access token for official Indian AWS/ARG station readings
# and district warnings. Register at https://api.imd.gov.in/public/index.php
IMD_API_KEY=

# Optional admin key. When configured, write endpoints require the
# X-Admin-API-Key request header. Cloud deployment should generate a secret.
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Optional local storage settings
DATA_DIR=./data
OUTPUT_DIR=./output
MAX_UPLOAD_SIZE=52428800

# Default dashboard region (centered on Jabalpur, Madhya Pradesh)
REGION_NAME=Jabalpur, Madhya Pradesh
REGION_LAT=23.181
REGION_LON=79.951
REGION_RADIUS_KM=250

# MQTT is enabled for local development. Set false in cloud deployments unless
# you have a separately hosted public MQTT broker configured.
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=sensor/data

# Optional USGS gage sites. Use actual USGS site IDs and locally verified stage thresholds.
# Example shape: {"SITE_ID":{"action_stage_m":2.0,"flood_stage_m":3.0}}
USGS_WATER_STATIONS={}
